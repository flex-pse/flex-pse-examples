<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>flex-pse examples</title>
<meta name="description" content="Interactive process-scheduling examples built with flex-pse: optimization models you can explore in the browser.">
<style>
{{ inline_css }}
</style>
<script>
  /* Stamp the saved theme before first paint so a returning dark-mode reader
     never sees a white flash. Light is the default: the system preference is
     deliberately not consulted. localStorage throws in some privacy contexts,
     and the page must still render (light) when it does. */
  try {
    if (localStorage.getItem("theme") === "dark") {
      document.documentElement.dataset.theme = "dark";
    }
  } catch (e) {}
</script>
</head>
<body>

<header class="masthead">
  <div class="wrap">
    <div class="masthead-top">
      <h1>Interactive process-scheduling examples</h1>
      <button class="theme-toggle" type="button" hidden aria-pressed="false"></button>
    </div>
    <p class="lede">
      A gallery of process-systems test problems built with
      <a href="https://github.com/flex-pse/flexPSE">flex-pse</a> — industrial plants
      scheduled against real tariffs, each one solved offline and laid out here as a
      page you can explore without installing anything.
    </p>
    <p class="masthead-links">
      <a href="{{ repo_url }}">Source on GitHub</a>
      <a href="https://github.com/flex-pse/flexPSE">flex-pse</a>
      <a href="{{ repo_url }}/blob/main/CONTRIBUTING.md">Add an example</a>
    </p>
  </div>
</header>

<main class="wrap">

<section class="overview">
  <h2>What this is</h2>
  <div class="cols">
    <div>
      <p>
        <strong>flex-pse</strong> is a process-systems toolbox for constrained
        optimization over time-dependent industrial operations. You describe a
        flowsheet — pumps, tanks, membranes, batteries — and it builds the Pyomo
        model that decides how to run it: which units are on, at what duty, in
        which hour, against a tariff that makes some hours far more expensive
        than others.
      </p>
      <p>
        Every example here is a complete problem instance rather than a toy: a
        real flowsheet, a real tariff, and a question with a non-obvious answer.
        Each has a page below, a model you can read, and a notebook that builds
        and solves it.
      </p>
    </div>
    <div>
      <div class="note">
        <h3>How these pages work</h3>
        <p>
          The optimization needs Pyomo, IDAES and a MILP solver, none of which
          have a WebAssembly build — so nothing solves in your browser. Instead,
          each model is solved offline across a sweep of one design parameter,
          and the results are committed to the repository. The pages replay that
          sweep: the charts, tables and controls are live, but the schedules
          behind them were computed in advance.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="examples">
  <h2>Examples</h2>
  <ul class="grid">
    {% for example in examples %}
    <li class="card">
      <h3><a href="{{ example.page }}">{{ example.title }}</a></h3>
      <p class="blurb">{{ example.blurb }}</p>
      <p class="actions">
        <a class="primary" href="{{ example.page }}">Explore &rarr;</a>
        <a href="{{ example.source_url }}">Model</a>
        <a href="{{ example.solver_url }}">Notebook</a>
      </p>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="start">
  <h2>Running them yourself</h2>
  <p>
    The pages above are read-only replays. To change the problem — a different
    tariff, a different demand, a different flowsheet — clone the repository and
    run the solver-level notebooks:
  </p>
<pre><code>git clone {{ repo_url }}.git
cd flex-pse-examples
conda env create -f environment.yml
conda activate flex-pse-examples

marimo run examples/pump_scheduling/notebook.py</code></pre>
  <p>
    Regenerate a page's data with
    <code>python tools/sweep.py examples/&lt;name&gt;</code>, and rebuild the site with
    <code>python tools/site/build.py --out _site</code>. Adding a new example is
    documented in <a href="{{ repo_url }}/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a>.
  </p>

  <div class="note">
    <p>
      <code>flex-pse</code> and this examples repository are maintained by the
      Coherence Power team and the WE3 Lab at Stanford University. For bug reports 
      and feature requests please open an issue on the <code>flex-pse</code> GitHub repository. 
      To add examples, see the <a href="{{ repo_url }}/blob/main/CONTRIBUTING.md">CONTRIBUTING.md</a> file.
    </p>
    <p>
      For support with custom analyses, please join our
      <a href="https://join.slack.com/t/flex-pse/shared_invite/zt-47sl8mt9h-a0hWUUJlm73aj3uvJRi9hw">Slack Workspace</a>
      or email <a href="mailto:info@coherencepower.com">info@coherencepower.com</a>.
    </p>
  </div>
</section>

</main>

<footer class="wrap">
  <p>
    Built with <a href="https://marimo.io">marimo</a> and served from GitHub Pages.
    The notebook pages load their Python runtime from a CDN, so they need a
    network connection on first open.
  </p>
</footer>

<script>
  /* The toggle is markup-hidden by default, so a reader without JS never sees a
     dead control. */
  (function () {
    var root = document.documentElement;
    var button = document.querySelector(".theme-toggle");
    if (!button) return;

    var ICONS = {
      sun: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" ' +
        'stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">' +
        '<circle cx="12" cy="12" r="4.2"/>' +
        '<path d="M12 2v2.4M12 19.6V22M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2 12h2.4M19.6 12H22M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>' +
        '</svg>',
      moon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" ' +
        'stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' +
        '<path d="M20 14.1A8.5 8.5 0 1 1 9.9 4a6.8 6.8 0 0 0 10.1 10.1z"/>' +
        '</svg>'
    };

    function paint() {
      var dark = root.dataset.theme === "dark";
      button.innerHTML = dark ? ICONS.moon : ICONS.sun;
      button.setAttribute("aria-pressed", dark ? "true" : "false");
      button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
    }

    button.addEventListener("click", function () {
      if (root.dataset.theme === "dark") {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = "dark";
      }
      try {
        localStorage.setItem("theme", root.dataset.theme === "dark" ? "dark" : "light");
      } catch (e) {}
      paint();
    });

    button.hidden = false;
    paint();
  })();
</script>

</body>
</html>
